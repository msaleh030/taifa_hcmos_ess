{
  "name": "hcmos-platform",
  "version": "0.1.0",
  "private": true,
  "description": "HCMOS™ — Taifa Human Capital Management Operating System (production platform)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @hcmos/db generate",
    "db:migrate": "pnpm --filter @hcmos/db migrate:deploy",
    "db:seed": "pnpm --filter @hcmos/db seed",
    "dev:api": "pnpm --filter @hcmos/api dev",
    "dev:web": "pnpm --filter @hcmos/web dev"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "prisma", "@prisma/client", "@prisma/engines"]
  }
}
