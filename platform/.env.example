# ── Copy to .env and fill in. NEVER commit the real .env. ────────────────────

# Database (Postgres). RLS depends on the API connecting as a NON-superuser,
# non-BYPASSRLS role — see infra/DEPLOY.md.
DATABASE_URL="postgresql://hcmos_app:change-me@localhost:5432/hcmos?schema=public"

# API
API_PORT=4000
API_HOST=0.0.0.0
# Public origin of the web app, used for CORS. Comma-separated for multiple.
WEB_ORIGIN="http://localhost:5173,https://taifamining.tz"

# Auth — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="30d"
# TOTP issuer label shown in authenticator apps
MFA_ISSUER="HCMOS"

# Exact Online integration (OAuth2). Obtain from the Exact developer portal.
EXACT_BASE_URL="https://start.exactonline.nl"
EXACT_CLIENT_ID=""
EXACT_CLIENT_SECRET=""
EXACT_REDIRECT_URI="https://taifamining.tz/api/integrations/exact/callback"
# Leave blank to run the integration in stub mode (no live calls).
EXACT_DIVISION=""

# Web (Vite) — must be prefixed VITE_ to reach the browser bundle.
VITE_API_URL="http://localhost:4000"
